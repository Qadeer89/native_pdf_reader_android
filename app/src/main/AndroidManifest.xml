<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PDF-011 (Firebase cloud sync) and DEC-004 (AdMob ads) both need network access;
         neither existed in the manifest before (no network calls were made until now). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PdfReader"
        android:usesCleartextTraffic="false">

        <!-- DEC-004: Google's own published TEST App ID — safe for a public repo, must be
             replaced with the real AdMob App ID once the user creates a real AdMob account
             (see DEC-004 consequence (2) in docs/DECISIONS_AND_OPEN_QUESTIONS.md). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PdfReader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- PDF-001: file-association open ("Open with" / tapping a .pdf). Split into one
                 <data> per scheme per lint's IntentFilterUniqueDataAttributes: a single <data>
                 tag mixing multiple attribute kinds (scheme + mimeType here) is matched as a
                 cross product of every attribute seen anywhere in the intent-filter, not just
                 the pairings actually written, so two single-attribute-combo tags are clearer
                 and behave identically here (both already only pair one scheme with one type). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- PDF-001: share-intent open (share sheet "Open with PDF Reader") -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>

</manifest>
