<?xml version="1.0" encoding="utf-8"?>
<!--
  Backlog item 10 (lint cleanup): android:allowBackup="false" already means no backup or
  device-to-device transfer happens at all, so this file is currently a no-op in practice —
  but code comments elsewhere (LocalFileSignatureRepository, SignatureRepository) already
  describe the signatures directory and the signature-placement-memory SharedPreferences as
  "excluded from Android auto-backup per res/xml/data_extraction_rules.xml", so this file
  makes that true in case allowBackup is ever turned on, rather than leaving it a dangling
  reference. See docs/DECISIONS_AND_OPEN_QUESTIONS.md on visual signatures staying local-only.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="files/signatures" />
        <exclude domain="sharedpref" path="signature_placements.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="files/signatures" />
        <exclude domain="sharedpref" path="signature_placements.xml" />
    </device-transfer>
</data-extraction-rules>
